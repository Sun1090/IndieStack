# =============================================================================
# IndieStack - Environment Variables
# Copy to .env.local and fill in your values
# =============================================================================

# --- Next.js App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 开发 Mock 模式：设为 true 可无需 Supabase 环境变量即可本地开发
NEXT_PUBLIC_MOCK_ENABLED=true
NEXT_PUBLIC_APP_NAME="IndieStack"
NEXT_PUBLIC_APP_DESCRIPTION="A full-stack IndieStack for independent developers. Next.js, Tailwind, shadcn/ui, Supabase, PostgreSQL."
# 应用版本号（默认从 package.json 读取，部署时可显式覆盖）
NEXT_PUBLIC_APP_VERSION=0.3.0
# 联系邮箱（营销页/页脚联系链接，默认 hello@indiestack.dev）
NEXT_PUBLIC_CONTACT_EMAIL=hello@indiestack.dev
# 控制台详细日志（默认关闭，排障时设为 true）
NEXT_PUBLIC_VERBOSE_LOGGING=false
NEXT_PUBLIC_DOCS_URL=https://indie-stack-docs-site.vercel.app

# --- Supabase (Core - Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNjAwMDAwMDAwLCJleHAiOjE5OTAwMDAwMDB9.xxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE2MDAwMDAwMDAsImV4cCI6MTk5MDAwMDAwMH0.xxxxxxxxxx
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Sentry (Error Monitoring) ---
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# --- Alibaba Cloud OSS (File Storage) [规划中/预留] ---
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_BUCKET=your-bucket-name
ALIYUN_REGION=oss-cn-hangzhou
ALIYUN_CDN_DOMAIN=https://static.yourdomain.com

# --- Stripe (Payments - Optional) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRO_PRICE_ID=price_pro_monthly
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly

# --- Appark (APM) [规划中/预留] ---
NEXT_PUBLIC_APPARK_API_KEY=your-appark-api-key
